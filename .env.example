# Copy to .env on the server and fill in real values. Never commit .env.

NODE_ENV=production
PORT=3000

# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
ADMIN_KEY=replace-with-a-long-random-admin-key

# Absolute path to the SQLite file. Keep it outside the code directory.
DB_PATH=/var/lib/cds-election/election.db
